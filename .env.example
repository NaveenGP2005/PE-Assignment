# ==============================================================================
# Environment Configuration for LangChain RAG System
# ==============================================================================
# NOTE: The application supports 100% offline demonstration without API keys!
# If you want to connect live LLMs, insert your free API keys below and rename to .env:

# Free Gemini API Key from: https://aistudio.google.com/
GOOGLE_API_KEY=

# Free Groq (Llama-3) API Key from: https://console.groq.com/
GROQ_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=
